# Copy to .env and fill in what you use. Never commit .env.

# Printify -> Etsy: https://printify.com/app/account/api  (create a Personal Access Token)
PRINTIFY_TOKEN=

# Movies & TV (optional): themoviedb.org -> Settings -> API -> create a key (v3 key or v4 read token both work)
TMDB_API_KEY=

# YouTube trending (optional): Google Cloud console -> YouTube Data API v3 -> API key
YOUTUBE_API_KEY=

# Reddit API (optional; without it the bot uses public RSS): https://www.reddit.com/prefs/apps -> "script" app
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
